---
/** Logo WhatsApp officiel, décoratif : le nom accessible est porté par le lien parent. */
import { WHATSAPP_ICON_PATH } from '../lib/whatsapp.ts';

interface Props {
  size?: number;
  class?: string;
}

const { size = 24, class: className } = Astro.props;
---

<svg
  aria-hidden="true"
  focusable="false"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="currentColor"
  class={className}
>
  <path d={WHATSAPP_ICON_PATH}></path>
</svg>
