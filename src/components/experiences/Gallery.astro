---
/**
 * Galerie (FR-015) : bande défilante `scroll-snap`, compteur « k / N » et vignettes en liens
 * d'ancre. Aucun JavaScript. Une seule photo : ni compteur ni vignettes.
 */
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import IllustrativeTag from './IllustrativeTag.astro';

interface Props {
  /** `tag` : étiquette « Photo illustrative » ou « Photo à venir », déjà traduite. */
  images: {
    src: ImageMetadata;
    alt: string;
    tag?: string | undefined;
    focus?: string | undefined;
  }[];
  /** Nom de transition de la première photo, partagé avec la carte qui mène ici (009). */
  transitionName?: string;
  /** Libellés de la photo en grand (010) : ouvrir, fermer. */
  openLabel: string;
  closeLabel: string;
  thumbnailsLabel: string;
}

const { images, thumbnailsLabel, transitionName, openLabel, closeLabel } = Astro.props;
const styleOf = (index: number, focus: string | undefined) =>
  [
    index === 0 && transitionName ? `view-transition-name: ${transitionName}` : '',
    focus ? `object-position: ${focus}` : '',
  ]
    .filter(Boolean)
    .join('; ') || undefined;
const several = images.length > 1;
---

<div data-testid="gallery">
  <ul
    class="flex snap-x snap-mandatory overflow-x-auto rounded-card"
    aria-label={several ? thumbnailsLabel : undefined}
  >
    {images.map((image, index) => (
      <li
        id={`photo-${index + 1}`}
        class="relative w-full shrink-0 snap-start scroll-mt-(--size-header)"
      >
        <!-- Photo en grand (010) : le script l'ouvre dans la fenêtre ; sans lui, le lien mène à l'image. -->
        <a
          href={image.src.src}
          class="block"
          data-lightbox-open
          aria-label={`${openLabel} : ${image.alt}`}
        >
          <Image
            src={image.src}
            alt={image.alt}
            widths={[480, 960]}
            quality={65}
            sizes="(min-width: 64rem) 50vw, 100vw"
            loading={index === 0 ? 'eager' : 'lazy'}
            fetchpriority={index === 0 ? 'high' : 'auto'}
            class="aspect-4/3 w-full object-cover"
            style={styleOf(index, image.focus)}
          />
        </a>
        {image.tag && <IllustrativeTag label={image.tag} />}
        {several && (
          <span
            class="absolute right-2.5 bottom-2.5 rounded-sm bg-fg/70 px-2 py-0.5 text-xs font-medium text-bg"
            data-counter
          >
            {index + 1} / {images.length}
          </span>
        )}
      </li>
    ))}
  </ul>
  {several && (
    <ul class="mt-2 flex flex-wrap gap-2">
      {images.map((image, index) => (
        <li>
          <a
            href={`#photo-${index + 1}`}
            class="block size-18 overflow-hidden rounded-sm border border-border"
            aria-label={`${index + 1} / ${images.length} — ${image.alt}`}
          >
            <Image
              src={image.src}
              alt=""
              width={144}
              quality={60}
              class="h-full w-full object-cover"
            />
          </a>
        </li>
      ))}
    </ul>
  )}
</div>

<dialog
  data-lightbox
  data-testid="lightbox"
  class="m-0 h-full max-h-none w-full max-w-none bg-transparent p-0 backdrop:bg-fg/90"
>
  <div class="flex h-full w-full items-center justify-center p-4">
    <img alt="" class="max-h-full max-w-full object-contain" />
  </div>
  <button
    type="button"
    data-lightbox-close
    class="press absolute top-4 right-4 inline-flex min-h-11 items-center rounded-md bg-bg px-4 text-sm font-semibold text-fg"
  >
    {closeLabel}
  </button>
</dialog>

<script>
  import '../../scripts/lightbox.ts';
</script>
