---
/** Bloc prix de la fiche (FR-014) : prix ou tarifs nommés, équivalent euro, mention, badges. */
import type { CollectionEntry } from 'astro:content';
import { cardPrice } from '../../features/estimation/cardPrice.ts';
import { formatEurEquivalent, formatXaf } from '../../features/estimation/formatPrice.ts';
import { localize, t } from '../../i18n/t.ts';
import type { Locale } from '../../i18n/types.ts';
import { currency } from '../../lib/site.ts';
import Price from '../Price.astro';

interface Props {
  service: CollectionEntry<'services'>;
  locale: Locale;
}

const { service, locale } = Astro.props;
const { data } = service;
const main = cardPrice(data);
const maxCapacity =
  data.pricing && data.pricing.kind !== 'quote' ? data.pricing.maxCapacity : undefined;
---

<section data-testid="price-block">
  {data.tiers ? (
    <ul class="space-y-2">
      {data.tiers.map((tier) => (
        <li class="flex items-baseline justify-between gap-4 border-b border-border pb-2">
          <span class="font-semibold text-fg">{localize(tier.label, locale)}</span>
          <Price price={tier.pricing} locale={locale} />
        </li>
      ))}
    </ul>
  ) : main.kind === 'quote' ? (
    <Price price={main} locale={locale} />
  ) : (
    <div>
      <p class="flex flex-wrap items-baseline gap-1.5">
        <span class="text-3xl font-bold tracking-tight text-brand">
          {main.kind === 'from'
            ? t(locale, 'price.from', { amount: formatXaf(main.amount, locale) })
            : formatXaf(main.amount, locale)}
        </span>
        <span class="text-fg-muted">{t(locale, `price.unit.${main.unit}`)}</span>
      </p>
      <p class="mt-0.5 text-sm text-fg-muted" data-price-eur>
        {formatEurEquivalent(main.amount, locale, currency.eurToXaf)}
      </p>
    </div>
  )}
  <p class="mt-2 text-xs text-fg-muted">{t(locale, 'detail.priceNote')}</p>
  <div class="mt-3 flex flex-wrap gap-2">
    {maxCapacity && (
      <span class="rounded-sm bg-accent px-2.5 py-1 text-xs font-semibold text-bg">
        {t(locale, 'detail.capacityBadge', { count: maxCapacity })}
      </span>
    )}
    {data.availability === 'on_request' && (
      <span class="rounded-sm bg-fg px-2.5 py-1 text-xs font-semibold text-bg">
        {t(locale, 'experiences.onRequest')}
      </span>
    )}
  </div>
</section>
