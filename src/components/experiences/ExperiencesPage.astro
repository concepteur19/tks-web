---
/**
 * Page d'entrée du Tourisme (008, FR-002, FR-003) : bandeau, « Découvrez Kribi selon vos envies »,
 * une carte par univers qui a au moins une prestation publiée, bloc WhatsApp.
 */
import { Image } from 'astro:assets';
import banner from '../../assets/photos/sections/bandeau-experiences.jpg';
import { getRoutePath } from '../../i18n/routes.ts';
import { t } from '../../i18n/t.ts';
import type { Locale } from '../../i18n/types.ts';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { categoriesWithExperiences } from '../../lib/catalog.ts';
import Icon from '../Icon.astro';
import SpecialRequest from './SpecialRequest.astro';
import UniverseCard from './UniverseCard.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const universes = await categoriesWithExperiences();
---

<BaseLayout
  locale={locale}
  routeKey="experiences"
  title={t(locale, 'experiences.title')}
  description={t(locale, 'experiences.description')}
  ogImage={banner}
  ogImageAlt={t(locale, 'experiences.bannerAlt')}
>
  <section class="relative isolate flex h-56 items-end overflow-hidden" data-section="banner">
    <Image
      src={banner}
      alt={t(locale, 'experiences.bannerAlt')}
      widths={[480, 960, 1440]}
      width={960}
      height={540}
      fit="cover"
      quality={60}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
      class="absolute inset-0 -z-10 h-full w-full object-cover"
    />
    <div class="absolute inset-0 -z-10 bg-linear-to-t from-fg/80 to-fg/20"></div>
    <div class="mx-auto w-full max-w-(--size-content) px-4 pb-6 text-brand-contrast">
      <h1 class="font-display text-4xl font-extrabold">{t(locale, 'experiences.title')}</h1>
      <p class="mt-1 text-lg">{t(locale, 'experiences.tagline')}</p>
    </div>
  </section>

  <section class="mx-auto max-w-(--size-content) px-4 py-10" data-section="universes">
    <h2 class="font-display text-2xl font-extrabold text-fg lg:text-3xl">
      {t(locale, 'experiences.universesTitle')}
    </h2>
    <ul data-reveal-group class="mt-6 grid gap-5 lg:grid-cols-3">
      {universes.map((universe) => (
        <li>
          <UniverseCard universe={universe} locale={locale} />
        </li>
      ))}
    </ul>
    <a
      href={`${getRoutePath('packages', locale)}#parcours`}
      class="mt-6 flex items-center justify-between gap-4 rounded-card border-l-4 border-brand bg-bg-muted p-5 text-fg"
      data-testid="tours-entry"
    >
      <span>
        <span class="block font-display text-xl font-bold">
          {t(locale, 'experiences.toursEntry.title')}
        </span>
        <span class="mt-1 block text-sm text-fg-muted">
          {t(locale, 'experiences.toursEntry.text')}
        </span>
      </span>
      <Icon name="arrow" />
    </a>
  </section>

  <SpecialRequest locale={locale} />
</BaseLayout>
