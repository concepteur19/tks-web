---
/** Inclus, non inclus, à savoir (FR-013) : listes l'une sous l'autre, chacune omise si vide. */
import type { CollectionEntry } from 'astro:content';
import { localize, t } from '../../i18n/t.ts';
import type { Locale } from '../../i18n/types.ts';
import Icon from '../Icon.astro';

interface Props {
  service: CollectionEntry<'services'>;
  locale: Locale;
}

const { service, locale } = Astro.props;
const conditions = service.data.conditions;
const lists = [
  ['detail.included', conditions?.included, 'check', 'text-success'],
  ['detail.excluded', conditions?.excluded, 'close', 'text-fg-muted'],
  ['detail.notes', conditions?.notes, 'info', 'text-accent'],
] as const;
---

{lists.map(
  ([key, items, icon, color]) =>
    items &&
    items.length > 0 && (
      <section class="mt-6">
        <h2 class="mb-2.5 text-base font-bold text-fg">{t(locale, key)}</h2>
        <ul class="space-y-2 text-sm">
          {items.map((item) => (
            <li class="flex items-start gap-2.5">
              <Icon name={icon} size={18} class={`mt-0.5 shrink-0 ${color}`} />
              <span>{localize(item, locale)}</span>
            </li>
          ))}
        </ul>
      </section>
    ),
)}
