---
/** Fiche d'une expérience (FR-012 à FR-020, FR-025, FR-026). */
import { getImage } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { relatedExperiences } from '../../features/catalog/relatedExperiences.ts';
import { cardPrice } from '../../features/estimation/cardPrice.ts';
import { buildServiceRequestMessage } from '../../features/whatsapp/buildServiceRequestMessage.ts';
import { getRoutePath } from '../../i18n/routes.ts';
import { localize, t } from '../../i18n/t.ts';
import { LOCALES, type Locale } from '../../i18n/types.ts';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCategories, getExperiences, getOptions } from '../../lib/catalog.ts';
import { env } from '../../lib/env.ts';
import { buildExperienceJsonLd, buildWhatsAppUrl } from '../../lib/seo.ts';
import CompactCard from './CompactCard.astro';
import Conditions from './Conditions.astro';
import Gallery from './Gallery.astro';
import InfoRow from './InfoRow.astro';
import OptionsList from './OptionsList.astro';
import PriceBlock from './PriceBlock.astro';
import StickyRequest from './StickyRequest.astro';

interface Props {
  service: CollectionEntry<'services'>;
  locale: Locale;
}

const { service, locale } = Astro.props;
const { data } = service;
const [experiences, options, categories] = await Promise.all([
  getExperiences(),
  getOptions(),
  getCategories(),
]);
const category = categories.find((entry) => entry.id === data.categoryId);
const title = localize(data.title, locale);
const description = localize(data.shortDescription, locale);
const listPath = getRoutePath('experiences', locale);
const alternatePaths = Object.fromEntries(
  LOCALES.map((code) => [code, `${getRoutePath('experiences', code)}/${service.id}`]),
) as Record<Locale, string>;
const pageUrl = new URL(alternatePaths[locale], `${env.siteUrl}/`).toString();
const price = cardPrice(data);
const images = (data.images ?? []).map((image) => ({
  src: image.src,
  alt: localize(image.alt, locale),
}));
const firstImage = images[0];
const share = firstImage
  ? await getImage({ src: firstImage.src, width: 1200, height: 630, fit: 'cover', format: 'jpg' })
  : undefined;
const requestHref = buildWhatsAppUrl(
  env.whatsappNumber,
  buildServiceRequestMessage({ title, url: pageUrl, locale }),
);
const jsonLd = buildExperienceJsonLd({
  title,
  description,
  url: pageUrl,
  imageUrl: share ? new URL(share.src, `${env.siteUrl}/`).toString() : pageUrl,
  locale,
  siteUrl: env.siteUrl,
  price,
  ...(price.kind !== 'quote'
    ? { unitLabel: t(locale, `price.unit.${price.unit}`).replace(/^\/\s*/, '') }
    : {}),
});
const related = relatedExperiences(service.id, experiences);
---

<BaseLayout
  locale={locale}
  routeKey="experiences"
  title={title}
  description={description}
  alternatePaths={alternatePaths}
  floatingWhatsApp={false}
  jsonLd={[jsonLd]}
  {...(firstImage ? { ogImage: firstImage.src, ogImageAlt: firstImage.alt } : {})}
>
  <div class="mx-auto max-w-(--size-content) px-4 pt-3 pb-[calc(var(--size-sticky-cta)+var(--spacing)*6)] lg:pb-16">
    <nav aria-label={t(locale, 'detail.breadcrumb')} class="py-1 text-xs text-fg-muted">
      <ol class="flex flex-wrap items-center gap-1">
        <li>
          <a href={listPath} class="inline-flex min-h-11 items-center underline">
            {t(locale, 'experiences.title')}
          </a>
        </li>
        {category && (
          <li class="flex items-center gap-1">
            <span aria-hidden="true">›</span>
            <a
              href={`${listPath}#${category.id}`}
              class="inline-flex min-h-11 items-center underline"
            >
              {localize(category.data.name, locale)}
            </a>
          </li>
        )}
        <li class="flex items-center gap-1">
          <span aria-hidden="true">›</span>
          <span aria-current="page" class="font-medium text-fg">
            {title}
          </span>
        </li>
      </ol>
    </nav>

    <div class="mt-2 grid gap-8 lg:grid-cols-[minmax(0,1fr)_22rem]">
      <div class="min-w-0">
        {images.length > 0 && (
          <Gallery images={images} thumbnailsLabel={t(locale, 'detail.gallery')} />
        )}

        <h1 class="mt-4 font-display text-2xl leading-tight font-bold text-fg lg:text-4xl">
          {title}
        </h1>
        {category && (
          <p class="mt-1.5">
            <span class="inline-block rounded-sm bg-bg-muted px-2.5 py-1 text-xs font-semibold text-accent">
              {localize(category.data.name, locale)}
            </span>
          </p>
        )}

        <div class="mt-4">
          <PriceBlock service={service} locale={locale} />
        </div>
        <InfoRow service={service} locale={locale} />
        <p class="mt-4 leading-relaxed text-fg-muted">{localize(data.description, locale)}</p>
        <Conditions service={service} locale={locale} />
        <OptionsList options={options} locale={locale} />

        {related.length > 0 && (
          <section class="mt-8">
            <h2 class="text-base font-bold text-fg">{t(locale, 'detail.related')}</h2>
            <ul class="mt-3 grid gap-3 sm:grid-cols-3">
              {related.map((entry) => (
                <li>
                  <CompactCard service={entry} locale={locale} />
                </li>
              ))}
            </ul>
          </section>
        )}
      </div>

      <aside class="hidden lg:block">
        <div class="sticky top-[calc(var(--size-header-desktop)+var(--spacing)*4)]">
          <StickyRequest variant="card" price={price} href={requestHref} locale={locale} />
        </div>
      </aside>
    </div>
  </div>
  <StickyRequest variant="bar" price={price} href={requestHref} locale={locale} />
</BaseLayout>
