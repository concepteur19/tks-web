---
import { t } from '../i18n/t.ts';
import type { Locale } from '../i18n/types.ts';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="mt-16 border-t border-border bg-bg-muted">
  <div class="mx-auto max-w-5xl px-4 py-8 text-sm text-fg-muted">
    <p class="font-display text-base font-bold text-brand">{t(locale, 'site.name')}</p>
    <p class="font-script text-lg">{t(locale, 'site.tagline')}</p>
    <p class="mt-4">{t(locale, 'footer.location')}</p>
    <p class="mt-1">
      © {year} {t(locale, 'site.name')} — {t(locale, 'footer.rights')}
    </p>
  </div>
</footer>
