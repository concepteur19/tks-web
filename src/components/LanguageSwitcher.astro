---
import { getAlternatePath } from '../i18n/routes.ts';
import { t } from '../i18n/t.ts';
import { LOCALES, type Locale } from '../i18n/types.ts';

interface Props {
  locale: Locale;
  /** Chemins explicites d'une page hors de la table des routes (fiche). */
  alternatePaths?: Record<Locale, string> | undefined;
}

const { locale, alternatePaths } = Astro.props;
const currentPath = Astro.url.pathname;
const links = LOCALES.map((code) => ({
  code,
  // Normalisé par la table des routes, y compris pour la langue courante (pas de barre finale).
  href: alternatePaths?.[code] ?? getAlternatePath(currentPath, code),
  label: t(locale, code === 'fr' ? 'language.fr' : 'language.en'),
  isCurrent: code === locale,
}));
---

<nav aria-label={t(locale, 'nav.language')} class="flex items-center gap-1 text-sm">
  {links.map((link, index) => (
    <>
      {index > 0 && (
        <span aria-hidden="true" class="text-fg-muted/50">
          |
        </span>
      )}
      <a
        href={link.href}
        lang={link.code}
        hreflang={link.code}
        aria-current={link.isCurrent ? 'true' : undefined}
        data-locale={link.code}
        class:list={[
          // Maquette validée : langue active en rouge et en gras, l'autre en gris, sans soulignement.
          'min-h-11 inline-flex items-center px-2 rounded-sm',
          link.isCurrent
            ? 'font-extrabold text-brand'
            : 'font-medium text-fg-muted hover:text-fg hover:underline',
        ]}
      >
        {link.code.toUpperCase()}
        <span class="sr-only"> — {link.label}</span>
      </a>
    </>
  ))}
</nav>
