---
import { t } from '../i18n/t.ts';
import type { Locale } from '../i18n/types.ts';
import { env } from '../lib/env.ts';
import { buildWhatsAppUrl } from '../lib/seo.ts';
import WhatsAppIcon from './WhatsAppIcon.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const label = t(locale, 'whatsapp.label');
const href = buildWhatsAppUrl(env.whatsappNumber, t(locale, 'whatsapp.genericMessage'));
---

<a
  href={href}
  target="_blank"
  rel="noopener noreferrer"
  aria-label={label}
  data-testid="whatsapp-button"
  class="fixed bottom-4 right-4 inline-flex min-h-14 min-w-14 items-center justify-center rounded-pill bg-whatsapp text-whatsapp-contrast shadow-card"
  style="z-index: var(--z-fab)"
>
  <WhatsAppIcon size={28} />
</a>
