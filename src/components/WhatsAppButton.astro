---
import { t } from '../i18n/t.ts';
import type { Locale } from '../i18n/types.ts';
import { env } from '../lib/env.ts';
import { buildWhatsAppUrl } from '../lib/seo.ts';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const label = t(locale, 'whatsapp.label');
const href = buildWhatsAppUrl(env.whatsappNumber, t(locale, 'whatsapp.genericMessage'));
---

<a
  href={href}
  target="_blank"
  rel="noopener noreferrer"
  aria-label={label}
  data-testid="whatsapp-button"
  class="fixed bottom-4 right-4 inline-flex min-h-14 min-w-14 items-center justify-center rounded-pill bg-whatsapp text-whatsapp-contrast shadow-card"
  style="z-index: var(--z-fab)"
>
  <svg aria-hidden="true" focusable="false" width="28" height="28" viewBox="0 0 24 24" fill="currentColor">
    <path
      d="M12.04 2c-5.46 0-9.9 4.44-9.9 9.9 0 1.75.46 3.45 1.32 4.95L2 22l5.3-1.38a9.9 9.9 0 0 0 4.74 1.2h.01c5.46 0 9.9-4.44 9.9-9.9 0-2.64-1.03-5.13-2.9-7A9.82 9.82 0 0 0 12.04 2Zm0 18.02h-.01a8.2 8.2 0 0 1-4.19-1.15l-.3-.18-3.12.82.83-3.05-.2-.31a8.22 8.22 0 0 1-1.26-4.36c0-4.54 3.7-8.23 8.25-8.23 2.2 0 4.27.86 5.83 2.41a8.19 8.19 0 0 1 2.41 5.83c0 4.54-3.7 8.22-8.24 8.22Zm4.52-6.16c-.25-.13-1.47-.72-1.69-.81-.23-.08-.39-.12-.56.13-.16.24-.64.8-.78.97-.14.16-.29.18-.54.06-.25-.13-1.05-.39-2-1.23-.74-.66-1.24-1.47-1.38-1.72-.15-.25-.02-.38.11-.5.11-.11.25-.29.37-.43.13-.15.17-.25.25-.41.08-.17.04-.31-.02-.44-.06-.12-.56-1.35-.77-1.85-.2-.48-.41-.42-.56-.43h-.48c-.16 0-.43.06-.65.31-.22.25-.86.84-.86 2.05s.88 2.38 1 2.54c.12.17 1.73 2.64 4.2 3.7.59.26 1.04.41 1.4.52.59.19 1.12.16 1.54.1.47-.07 1.47-.6 1.67-1.18.21-.58.21-1.07.15-1.18-.06-.1-.22-.17-.47-.29Z"
    ></path>
  </svg>
</a>
