---
/**
 * Fiche d'un parcours (010, FR-006 à FR-010) : photo, description, durée, étapes, tarif indicatif,
 * mentions de Franck, ajout au séjour et personnalisation sur WhatsApp. Gabarit des fiches
 * d'expérience ; le tarif est celui du parcours, jamais la somme de ses étapes.
 */
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import { minimumParticipants } from '../../features/catalog/minimumParticipants.ts';
import { cardPrice } from '../../features/estimation/cardPrice.ts';
import TourActions from '../../features/selection/TourActions.tsx';
import { getRoutePath } from '../../i18n/routes.ts';
import { localize, t } from '../../i18n/t.ts';
import { LOCALES, type Locale } from '../../i18n/types.ts';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { env } from '../../lib/env.ts';
import { imageTag } from '../../lib/imageTag.ts';
import { getPageCatalog } from '../../lib/pageCatalog.ts';
import IllustrativeTag from '../experiences/IllustrativeTag.astro';
import Price from '../Price.astro';

interface Props {
  tour: CollectionEntry<'services'>;
  locale: Locale;
}

const { tour, locale } = Astro.props;
const { data } = tour;
const title = localize(data.title, locale);
const description = localize(data.description, locale);
const image = data.images?.[0];
const tag = image ? imageTag(image, locale) : undefined;
const minimum = minimumParticipants(data);
const listPath = getRoutePath('packages', locale);
const alternatePaths = Object.fromEntries(
  LOCALES.map((code) => [code, `${getRoutePath('packages', code)}/${tour.id}`]),
) as Record<Locale, string>;
const pageUrl = new URL(alternatePaths[locale], `${env.siteUrl}/`).toString();
const islandService = (await getPageCatalog()).find((entry) => entry.id === tour.id)!;
const experiencesPath = getRoutePath('experiences', locale);
---

<BaseLayout
  locale={locale}
  routeKey="packages"
  title={title}
  description={localize(data.shortDescription, locale)}
  alternatePaths={alternatePaths}
  {...(image ? { ogImage: image.src, ogImageAlt: localize(image.alt, locale) } : {})}
>
  <div class="mx-auto max-w-(--size-content) px-4 pt-3 pb-12">
    <nav aria-label={t(locale, 'detail.breadcrumb')} class="py-1 text-xs text-fg-muted">
      <ol class="flex flex-wrap items-center gap-1">
        <li>
          <a href={`${listPath}#parcours`} class="inline-flex min-h-11 items-center underline">
            {t(locale, 'packages.title')}
          </a>
        </li>
        <li class="flex items-center gap-1">
          <span aria-hidden="true">›</span>
          <span aria-current="page" class="font-medium text-fg">
            {title}
          </span>
        </li>
      </ol>
    </nav>

    <div class="mt-2 grid gap-8 lg:grid-cols-[minmax(0,1fr)_22rem]">
      <div class="min-w-0">
        {image && (
          <div class="relative aspect-4/3 w-full overflow-hidden rounded-card bg-bg-muted">
            <Image
              src={image.src}
              alt={localize(image.alt, locale)}
              widths={[480, 960]}
              quality={65}
              sizes="(min-width: 64rem) 50vw, 100vw"
              loading="eager"
              fetchpriority="high"
              class="absolute inset-0 h-full w-full object-cover"
              style={image.focus ? `object-position: ${image.focus}` : undefined}
            />
            {tag && <IllustrativeTag label={tag} />}
          </div>
        )}
        <h1 class="mt-4 font-display text-2xl leading-tight font-bold text-fg lg:text-4xl">
          {title}
        </h1>
        {data.duration && (
          <p class="mt-1 text-sm text-fg-muted" data-testid="tour-duration">
            {t(locale, 'packages.tours.duration')} : {localize(data.duration, locale)}
          </p>
        )}
        <p class="mt-4 leading-relaxed text-fg">{description}</p>

        <section class="mt-6">
          <h2 class="text-base font-bold text-fg">{t(locale, 'packages.tours.steps')}</h2>
          <ol class="mt-3 space-y-2 text-fg" data-testid="tour-steps">
            {data.steps?.map((step, index) => (
              <li class="flex items-baseline gap-2">
                <span
                  class="inline-flex size-6 shrink-0 items-center justify-center rounded-sm bg-accent-soft text-xs font-bold text-accent"
                  aria-hidden="true"
                >
                  {index + 1}
                </span>
                {step.serviceId ? (
                  <a
                    href={`${experiencesPath}/${step.serviceId}`}
                    class="underline underline-offset-2"
                  >
                    {localize(step.label, locale)}
                  </a>
                ) : (
                  <span>{localize(step.label, locale)}</span>
                )}
              </li>
            ))}
          </ol>
        </section>
      </div>

      <aside class="h-fit rounded-card bg-bg p-5 shadow-card lg:sticky lg:top-(--size-header-desktop)">
        <Price price={cardPrice(data)} locale={locale} />
        <div class="mt-2 flex flex-wrap gap-2">
          {minimum && (
            <span class="rounded-sm bg-accent-soft px-2.5 py-1 text-xs font-semibold text-accent">
              {t(locale, 'price.minimum', { count: minimum })}
            </span>
          )}
        </div>
        {data.degressive && (
          <p class="mt-2 text-xs text-fg-muted" data-degressive>
            {t(locale, 'price.degressive')}
          </p>
        )}
        <p class="mt-3 text-xs text-fg-muted">{t(locale, 'packages.tours.indicative')}</p>
        <p class="mt-1 text-xs text-fg-muted">{t(locale, 'packages.tours.finalPrice')}</p>
        <div class="mt-5">
          <TourActions
            client:visible
            service={islandService}
            locale={locale}
            title={title}
            url={pageUrl}
            whatsappNumber={env.whatsappNumber}
          />
        </div>
      </aside>
    </div>
  </div>
</BaseLayout>
