---
import { Picture } from 'astro:assets';
import heroPhoto from '../../assets/photos/hero/plage-coucher-de-soleil.jpg';
import heroPhoto2 from '../../assets/photos/hero/kribi-2.jpg';
import heroPhoto3 from '../../assets/photos/hero/kribi-3.jpg';
import heroPhoto4 from '../../assets/photos/hero/kribi-4.jpg';
import bagyeliPhoto from '../../assets/photos/experiences/campement-bagyeli-4.jpg';
import portPhoto from '../../assets/photos/experiences/port-autonome-de-kribi-6.jpg';
import turtlesPhoto from '../../assets/photos/experiences/village-ebodje-5.jpg';
import { t } from '../../i18n/t.ts';
import type { Locale } from '../../i18n/types.ts';
import BrandLogo from '../BrandLogo.astro';
import Icon from '../Icon.astro';
import SmartLink from '../SmartLink.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
// Diaporama (010) : la première photo est l'image prioritaire d'avant ; les autres arrivent après.
const slides = [
  { src: heroPhoto, alt: t(locale, 'home.hero.alt') },
  { src: heroPhoto2, alt: t(locale, 'home.hero.alt2') },
  { src: heroPhoto3, alt: t(locale, 'home.hero.alt3') },
  { src: heroPhoto4, alt: t(locale, 'home.hero.alt4') },
  // Photos paysage : `position` garde le sujet dans le cadre portrait du téléphone.
  { src: bagyeliPhoto, alt: t(locale, 'home.hero.alt5'), position: '38% 50%' },
  { src: portPhoto, alt: t(locale, 'home.hero.alt6'), position: '64% 50%' },
  { src: turtlesPhoto, alt: t(locale, 'home.hero.alt7'), position: '60% 50%' },
];
---

<section
  data-section="hero"
  class="relative isolate flex h-(--size-hero-mobile) items-end overflow-hidden lg:max-h-(--size-hero-max)"
>
  <div data-slide data-active class="hero-slide absolute inset-0 -z-10">
    <Picture
      src={slides[0]!.src}
      alt={slides[0]!.alt}
      formats={['webp']}
      widths={[480, 828]}
      quality={55}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
      class="h-full w-full object-cover"
    />
  </div>
  <!-- Photos suivantes du diaporama : insérées par le script une fois la page chargée, pour ne
       pas concurrencer la première (LCP). Sans JavaScript, la première reste seule. -->
  <template data-hero-more>
    {slides.slice(1).map((slide) => (
      <div data-slide class="hero-slide absolute inset-0 -z-10">
        <Picture
          src={slide.src}
          alt={slide.alt}
          formats={['webp']}
          widths={[480, 828]}
          quality={55}
          sizes="100vw"
          class="h-full w-full object-cover"
          style={slide.position ? `object-position: ${slide.position}` : undefined}
        />
      </div>
    ))}
  </template>
  <div class="absolute inset-0 -z-10 bg-linear-to-t from-fg/85 via-fg/40 to-transparent"></div>

  <div class="mx-auto w-full max-w-(--size-content) px-4 pb-14 text-brand-contrast">
    <BrandLogo variant="wordmark" class="h-12 w-auto lg:h-14" label="Kibreeze" />
    <p class="mt-1 font-script text-2xl">{t(locale, 'site.tagline')}</p>
    <h1 class="mt-4 max-w-xl font-display text-4xl leading-tight font-extrabold lg:text-5xl">
      {t(locale, 'home.title')}
    </h1>
    <p class="mt-3 max-w-xl text-base leading-relaxed">{t(locale, 'home.subtitle')}</p>
    <div class="mt-6 flex flex-col gap-3 sm:flex-row">
      <SmartLink
        routeKey="experiences"
        locale={locale}
        class="press inline-flex min-h-12 items-center justify-center gap-2 rounded-md bg-brand px-5 font-semibold text-brand-contrast"
        data-testid="hero-cta-experiences"
      >
        {t(locale, 'home.cta.experiences')}
      </SmartLink>
      <SmartLink
        routeKey="stay"
        locale={locale}
        class="inline-flex min-h-12 items-center justify-center gap-2 rounded-md border-2 border-brand-contrast px-5 font-semibold text-brand-contrast"
      >
        {t(locale, 'home.cta.plan')}
      </SmartLink>
    </div>
  </div>
  <button
    type="button"
    hidden
    class="press absolute right-4 bottom-3 inline-flex size-11 items-center justify-center rounded-pill bg-fg/40 text-brand-contrast"
    aria-label={t(locale, 'home.hero.pause')}
    aria-pressed="false"
    data-testid="hero-pause"
  >
    <svg
      class="hero-icon-pause"
      aria-hidden="true"
      width="20"
      height="20"
      viewBox="0 0 24 24"
      fill="currentColor"
    >
      <path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"></path>
    </svg>
    <svg
      class="hero-icon-play"
      aria-hidden="true"
      width="20"
      height="20"
      viewBox="0 0 24 24"
      fill="currentColor"
    >
      <path d="M8 5v14l11-7z"></path>
    </svg>
  </button>
  <Icon
    name="chevronDown"
    size={32}
    class="hero-chevron absolute bottom-3 left-1/2 -translate-x-1/2 text-brand-contrast"
  />
</section>

<script>
  import '../../scripts/hero-slideshow.ts';
</script>

<style>
  /* Une seule photo visible ; sans JavaScript, la première (attribut posé au rendu). */
  .hero-slide {
    opacity: 0;
    transition: opacity var(--duration-slow) var(--ease-standard);
  }
  .hero-slide[data-active] {
    opacity: 1;
  }
  [aria-pressed='true'] .hero-icon-pause,
  [aria-pressed='false'] .hero-icon-play {
    display: none;
  }
  @keyframes hint {
    0%,
    100% {
      transform: translate(-50%, 0);
    }
    50% {
      transform: translate(-50%, 0.375rem);
    }
  }
  .hero-chevron {
    animation: hint 1.8s var(--ease-standard) infinite;
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-chevron {
      animation: none;
    }
  }
</style>
