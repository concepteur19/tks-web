---
import { Picture } from 'astro:assets';
import heroPhoto from '../../assets/photos/hero/plage-coucher-de-soleil.jpg';
import { t } from '../../i18n/t.ts';
import type { Locale } from '../../i18n/types.ts';
import BrandLogo from '../BrandLogo.astro';
import Icon from '../Icon.astro';
import SmartLink from '../SmartLink.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<section
  data-section="hero"
  class="relative isolate flex h-(--size-hero-mobile) items-end overflow-hidden lg:max-h-(--size-hero-max)"
>
  <Picture
    src={heroPhoto}
    alt={t(locale, 'home.hero.alt')}
    formats={['avif', 'webp']}
    widths={[640, 960]}
    sizes="100vw"
    loading="eager"
    fetchpriority="high"
    class="absolute inset-0 -z-10 h-full w-full object-cover"
  />
  <div class="absolute inset-0 -z-10 bg-linear-to-t from-fg/85 via-fg/40 to-transparent"></div>

  <div class="mx-auto w-full max-w-(--size-content) px-4 pb-14 text-brand-contrast">
    <BrandLogo variant="wordmark" class="h-12 w-auto lg:h-14" label="Kibreeze" />
    <p class="mt-1 font-script text-2xl">{t(locale, 'site.tagline')}</p>
    <h1 class="mt-4 max-w-xl font-display text-4xl leading-tight font-extrabold lg:text-5xl">
      {t(locale, 'home.title')}
    </h1>
    <p class="mt-3 max-w-xl text-base leading-relaxed">{t(locale, 'home.subtitle')}</p>
    <div class="mt-6 flex flex-col gap-3 sm:flex-row">
      <SmartLink
        routeKey="experiences"
        locale={locale}
        class="inline-flex min-h-12 items-center justify-center gap-2 rounded-md bg-brand px-5 font-semibold text-brand-contrast"
        data-testid="hero-cta-experiences"
      >
        {t(locale, 'home.cta.experiences')}
      </SmartLink>
      <SmartLink
        routeKey="stay"
        locale={locale}
        class="inline-flex min-h-12 items-center justify-center gap-2 rounded-md border-2 border-brand-contrast px-5 font-semibold text-brand-contrast"
      >
        {t(locale, 'home.cta.plan')}
      </SmartLink>
    </div>
  </div>
  <Icon
    name="chevronDown"
    size={32}
    class="hero-chevron absolute bottom-3 left-1/2 -translate-x-1/2 text-brand-contrast"
  />
</section>

<style>
  @keyframes hint {
    0%,
    100% {
      transform: translate(-50%, 0);
    }
    50% {
      transform: translate(-50%, 0.375rem);
    }
  }
  .hero-chevron {
    animation: hint 1.8s var(--ease-standard) infinite;
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-chevron {
      animation: none;
    }
  }
</style>
