---
import { localize, t } from '../../i18n/t.ts';
import type { Locale } from '../../i18n/types.ts';
import { homeTeasers } from '../../lib/site.ts';
import Price from '../Price.astro';
import SmartLink from '../SmartLink.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<section data-section="packages" class="bg-brand-warm text-brand-contrast">
  <div class="mx-auto max-w-(--size-content) px-4 py-12">
    <h2 class="font-display text-3xl font-extrabold">{t(locale, 'home.packages.title')}</h2>
    <ul class="mt-6 grid gap-4 lg:grid-cols-2">
      {homeTeasers.packages.map((card) => (
        <li class="rounded-card bg-bg p-5 text-fg">
          <h3 class="font-display text-xl font-bold">{localize(card.title, locale)}</h3>
          {card.summary && (
            <p class="mt-1 text-sm text-fg-muted">{localize(card.summary, locale)}</p>
          )}
          <div class="mt-3">
            <Price price={card.price} locale={locale} />
          </div>
        </li>
      ))}
    </ul>
    <SmartLink
      routeKey="packages"
      locale={locale}
      class="mt-6 inline-flex min-h-11 items-center gap-2 font-semibold underline underline-offset-4"
    >
      {t(locale, 'home.packages.cta')}
    </SmartLink>
  </div>
</section>
