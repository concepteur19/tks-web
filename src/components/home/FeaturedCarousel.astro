---
import { Image } from 'astro:assets';
import { cardPrice } from '../../features/estimation/cardPrice.ts';
import { localize, t } from '../../i18n/t.ts';
import type { Locale } from '../../i18n/types.ts';
import { getFeatured } from '../../lib/catalog.ts';
import Price from '../Price.astro';
import QuickAdd from '../../features/selection/QuickAdd.tsx';
import { getPageCatalog } from '../../lib/pageCatalog.ts';
import SmartLink from '../SmartLink.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const featured = await getFeatured();
const islandCatalog = await getPageCatalog();
---

<section data-section="featured" data-reveal class="py-12">
  <div class="mx-auto max-w-(--size-content) px-4">
    <h2 class="font-display text-3xl font-extrabold text-fg">{t(locale, 'home.featured.title')}</h2>
  </div>
  <ul
    class="relative mx-auto mt-6 flex max-w-(--size-content) snap-x snap-mandatory gap-4 overflow-x-auto px-4 pb-2 lg:grid lg:grid-cols-4 lg:overflow-visible"
    aria-label={t(locale, 'home.featured.title')}
  >
    {featured.map((service) => {
      const image = service.data.images?.[0];
      return (
        <li class="w-(--size-card-featured) shrink-0 snap-start lg:w-auto">
          <article
            data-reveal
            class="lift flex h-full flex-col overflow-hidden rounded-card bg-bg shadow-card"
          >
            <SmartLink
              routeKey="experiences"
              subpath={service.id}
              locale={locale}
              class="flex flex-1 flex-col"
              hideIcon
            >
              {image && (
                <Image
                  src={image.src}
                  alt={localize(image.alt, locale)}
                  widths={[320, 560]}
                  quality={70}
                  sizes="(min-width: 64rem) 25vw, 17.5rem"
                  class="media-zoom aspect-4/3 w-full object-cover"
                  style={`view-transition-name: exp-${service.id}`}
                />
              )}
              <span class="flex flex-1 flex-col gap-2 px-4 pt-4">
                <span class="font-display text-lg font-bold text-fg">
                  {localize(service.data.title, locale)}
                </span>
                <span class="text-sm text-fg-muted">
                  {localize(service.data.shortDescription, locale)}
                </span>
              </span>
            </SmartLink>
            <div class="flex items-end justify-between gap-3 px-4 pt-2 pb-4">
              <Price price={cardPrice(service.data)} locale={locale} />
              <QuickAdd
                client:visible
                service={islandCatalog.find((entry) => entry.id === service.id)!}
                locale={locale}
                title={localize(service.data.title, locale)}
              />
            </div>
          </article>
        </li>
      );
    })}
  </ul>
  <p class="mx-auto mt-3 max-w-(--size-content) px-4 text-xs text-fg-muted" data-indicative>
    {t(locale, 'price.indicative')}
  </p>
</section>
