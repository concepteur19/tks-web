---
/** Cartes des univers sur l'accueil (008, FR-009) : un univers non vide, une carte vers sa page. */
import { Image } from 'astro:assets';
import { localize, t } from '../../i18n/t.ts';
import type { Locale } from '../../i18n/types.ts';
import { categoriesWithExperiences, categoryCount, universePath } from '../../lib/catalog.ts';
import Icon from '../Icon.astro';
import IllustrativeTag from '../experiences/IllustrativeTag.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const categories = await Promise.all(
  (await categoriesWithExperiences()).map(async (category) => ({
    ...category,
    count: await categoryCount(category.id),
  })),
);
---

<section data-section="categories" class="mx-auto max-w-(--size-content) px-4 py-12">
  <h2 class="font-display text-3xl font-extrabold text-fg">{t(locale, 'home.categories.title')}</h2>
  <ul class="mt-6 grid gap-4 lg:grid-cols-3">
    {categories.map((category) => (
      <li>
        <a
          href={universePath(category, locale)}
          class="relative isolate flex h-(--size-category-card) items-end overflow-hidden rounded-card p-5 text-brand-contrast"
        >
          <Image
            src={category.data.image.src}
            alt={localize(category.data.image.alt, locale)}
            widths={[400, 720]}
            quality={70}
            sizes="(min-width: 64rem) 33vw, 100vw"
            class="absolute inset-0 -z-10 h-full w-full object-cover"
          />
          <span class="absolute inset-0 -z-10 bg-linear-to-t from-fg/80 to-fg/10" />
          {category.data.image.illustrative && (
            <IllustrativeTag label={t(locale, 'experiences.illustrative')} top />
          )}
          <span class="flex w-full items-end justify-between gap-3">
            <span>
              <span class="block font-display text-2xl font-bold">
                {localize(category.data.name, locale)}
              </span>
              {category.count !== undefined && (
                <span class="text-sm">
                  {t(locale, 'home.categories.count', { count: category.count })}
                </span>
              )}
            </span>
            <Icon name="arrow" />
          </span>
        </a>
      </li>
    ))}
  </ul>
</section>
