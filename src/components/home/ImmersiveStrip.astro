---
import { Image } from 'astro:assets';
import photo from '../../assets/photos/sections/lobe-en-pirogue.jpg';
import { t } from '../../i18n/t.ts';
import type { Locale } from '../../i18n/types.ts';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<section
  data-section="strip"
  class="relative isolate flex h-(--size-strip) items-center justify-center overflow-hidden"
>
  <Image
    src={photo}
    alt={t(locale, 'home.strip.alt')}
    widths={[640, 1280]}
    quality={70}
    sizes="100vw"
    class="absolute inset-0 -z-10 h-full w-full object-cover"
  />
  <div class="absolute inset-0 -z-10 bg-fg/45"></div>
  <p class="px-4 text-center font-display text-base font-bold tracking-widest text-brand-contrast sm:text-xl lg:text-3xl lg:tracking-strip">
    {t(locale, 'home.strip.words')}
  </p>
</section>
