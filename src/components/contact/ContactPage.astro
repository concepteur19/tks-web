---
/**
 * Page Contact (FR-018, FR-WA-7) : numéro WhatsApp, localité, bouton générique, et la
 * présentation complète de Kibreeze (#a-propos). Pas de formulaire, pas d'horaires ;
 * une coordonnée non fournie est simplement absente.
 */
import { Image } from 'astro:assets';
import photo from '../../assets/photos/sections/kribi-palmiers.jpg';
import { localize, t } from '../../i18n/t.ts';
import type { Locale } from '../../i18n/types.ts';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { env } from '../../lib/env.ts';
import { formatPhone } from '../../lib/phone.ts';
import { buildWhatsAppUrl } from '../../lib/seo.ts';
import { company } from '../../lib/site.ts';
import WhatsAppIcon from '../WhatsAppIcon.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const whatsappHref = buildWhatsAppUrl(env.whatsappNumber, t(locale, 'whatsapp.genericMessage'));
const NETWORKS = { facebook: 'Facebook', instagram: 'Instagram', tiktok: 'TikTok' } as const;
---

<BaseLayout
  locale={locale}
  routeKey="contact"
  title={t(locale, 'contact.metaTitle')}
  description={t(locale, 'contact.description')}
>
  <section class="mx-auto max-w-(--size-content) px-4 py-12">
    <h1 class="font-display text-4xl font-extrabold text-fg">{t(locale, 'contact.title')}</h1>
    <p class="mt-3 max-w-xl text-fg-muted">{t(locale, 'contact.intro')}</p>

    <a
      href={whatsappHref}
      target="_blank"
      rel="noopener noreferrer"
      class="mt-6 inline-flex min-h-12 items-center gap-2 rounded-md bg-whatsapp px-5 font-semibold text-whatsapp-ink"
    >
      <WhatsAppIcon size={22} />
      {t(locale, 'whatsapp.label')}
    </a>

    <dl class="mt-8 grid gap-4 sm:grid-cols-2">
      <div>
        <dt class="text-sm text-fg-muted">{t(locale, 'contact.whatsapp')}</dt>
        <dd>
          <a
            href={whatsappHref}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex min-h-11 items-center text-lg font-semibold text-brand underline underline-offset-4"
          >
            {formatPhone(env.whatsappNumber)}
          </a>
        </dd>
      </div>
      <div>
        <dt class="text-sm text-fg-muted">{t(locale, 'contact.location')}</dt>
        <dd class="flex min-h-11 items-center text-lg">{localize(company.locality, locale)}</dd>
      </div>
      {company.email && (
        <div>
          <dt class="text-sm text-fg-muted">{t(locale, 'contact.email')}</dt>
          <dd>
            <a
              href={`mailto:${company.email}`}
              class="inline-flex min-h-11 items-center text-lg text-brand underline"
            >
              {company.email}
            </a>
          </dd>
        </div>
      )}
      {company.social.length > 0 && (
        <div>
          <dt class="text-sm text-fg-muted">{t(locale, 'contact.social')}</dt>
          <dd class="flex flex-wrap gap-x-4">
            {company.social.map((account) => (
              <a
                href={account.url}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex min-h-11 items-center text-brand underline"
              >
                {NETWORKS[account.network]}
              </a>
            ))}
          </dd>
        </div>
      )}
    </dl>
  </section>

  <section
    id="a-propos"
    class="mx-auto grid max-w-(--size-content) scroll-mt-(--size-header-desktop) gap-6 px-4 pb-16 lg:grid-cols-2 lg:items-center"
  >
    <Image
      src={photo}
      alt={t(locale, 'contact.about.alt')}
      widths={[400, 720]}
      quality={70}
      sizes="(min-width: 64rem) 50vw, 100vw"
      class="aspect-4/3 w-full rounded-card object-cover"
    />
    <div>
      <h2 class="font-display text-3xl font-extrabold text-fg">{t(locale, 'home.about.title')}</h2>
      <p class="mt-4 leading-relaxed">{localize(company.about.full, locale)}</p>
    </div>
  </section>
</BaseLayout>
