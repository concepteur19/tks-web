---
/**
 * Page Mobilité TKS® (006, FR-001 à FR-011, écran 08) : section secondaire et sobre, petites
 * photos. Catégories de véhicules (avec `models`) réglées en véhicules × jours, puis services sur
 * devis, puis encadré sur mesure. Kibreeze reste la marque de l'en-tête et du pied de page.
 */
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import tksMark from '../../assets/brand/tks-mark.png';
import shareImage from '../../assets/photos/mobility/luxe.jpg';
import { cardPrice } from '../../features/estimation/cardPrice.ts';
import LineCustomizer from '../../features/selection/LineCustomizer.tsx';
import QuickAdd from '../../features/selection/QuickAdd.tsx';
import { getRoutePath } from '../../i18n/routes.ts';
import { localize, t } from '../../i18n/t.ts';
import type { Locale } from '../../i18n/types.ts';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getMobility } from '../../lib/catalog.ts';
import { env } from '../../lib/env.ts';
import { getPageCatalog } from '../../lib/pageCatalog.ts';
import { buildWhatsAppUrl } from '../../lib/seo.ts';
import Price from '../Price.astro';
import WhatsAppIcon from '../WhatsAppIcon.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const [mobility, islandCatalog] = await Promise.all([getMobility(), getPageCatalog()]);
const vehicles = mobility.filter((service) => service.data.models);
const services = mobility.filter((service) => !service.data.models);
const pageUrl = new URL(getRoutePath('mobility', locale), `${env.siteUrl}/`).toString();

const islandOf = (service: CollectionEntry<'services'>) =>
  islandCatalog.find((entry) => entry.id === service.id)!;
const requestHref = (service: CollectionEntry<'services'>) =>
  buildWhatsAppUrl(
    env.whatsappNumber,
    t(locale, 'mobility.requestMessage', {
      title: localize(service.data.title, locale),
      url: `${pageUrl}#${service.id}`,
    }),
  );
const customHref = buildWhatsAppUrl(env.whatsappNumber, t(locale, 'whatsapp.genericMessage'));
const shareAlt = vehicles[0]?.data.images?.[0]?.alt;
---

<BaseLayout
  locale={locale}
  routeKey="mobility"
  title={t(locale, 'mobility.seo.title')}
  description={t(locale, 'mobility.seo.description')}
  ogImage={shareImage}
  ogImageAlt={shareAlt ? localize(shareAlt, locale) : t(locale, 'mobility.title')}
>
  <section class="border-b border-border bg-bg-muted" data-section="banner">
    <div class="mx-auto flex max-w-(--size-content) items-center gap-3.5 px-4 py-8">
      <Image src={tksMark} alt="TKS®" height={22} class="h-5.5 w-auto shrink-0" />
      <div class="min-w-0 flex-1">
        <h1 class="text-base leading-tight font-bold text-fg lg:text-2xl">
          {t(locale, 'mobility.title')}
        </h1>
        <p class="mt-1 text-sm leading-snug text-fg-muted">{t(locale, 'mobility.tagline')}</p>
      </div>
    </div>
  </section>

  <div class="mx-auto max-w-(--size-content) px-4 py-3">
    <p class="text-xs leading-relaxed text-fg-muted">{t(locale, 'mobility.brand')}</p>

    <section
      id="vehicules"
      class="mt-6 scroll-mt-(--size-header) lg:scroll-mt-(--size-header-desktop)"
    >
      <h2 class="text-lg font-bold text-fg">{t(locale, 'mobility.vehicles.title')}</h2>
      <ul class="mt-3 grid gap-4 lg:grid-cols-3">
        {vehicles.map((vehicle) => {
          const image = vehicle.data.images?.[0];
          const title = localize(vehicle.data.title, locale);
          return (
            <li
              id={vehicle.id}
              class="scroll-mt-(--size-header) rounded-card bg-bg p-4 shadow-card"
              data-testid="vehicle-category"
            >
              <div class="flex items-center gap-3">
                {image && (
                  <Image
                    src={image.src}
                    alt={localize(image.alt, locale)}
                    width={112}
                    height={112}
                    fit="cover"
                    quality={65}
                    class="h-14 w-14 shrink-0 rounded-sm object-cover"
                  />
                )}
                <div class="min-w-0 flex-1">
                  <h3 class="text-sm leading-tight font-semibold text-fg">{title}</h3>
                  <p class="mt-0.5 text-xs leading-snug text-fg-muted">
                    {vehicle.data.models!.join(', ')}
                  </p>
                </div>
              </div>
              <div class="mt-3">
                <Price price={cardPrice(vehicle.data)} locale={locale} />
              </div>
              <div class="mt-3">
                <LineCustomizer
                  client:visible
                  service={islandOf(vehicle)}
                  locale={locale}
                  title={title}
                  buttonLabel={t(locale, 'mobility.add')}
                />
                <noscript>
                  <a
                    href={requestHref(vehicle)}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex min-h-11 items-center text-sm font-semibold text-brand underline"
                  >
                    {t(locale, 'mobility.request')}
                  </a>
                </noscript>
              </div>
            </li>
          );
        })}
      </ul>
      <p class="mt-3 text-xs text-fg-muted">{t(locale, 'mobility.vehicles.note')}</p>
    </section>

    <section
      id="services"
      class="mt-8 scroll-mt-(--size-header) lg:scroll-mt-(--size-header-desktop)"
    >
      <h2 class="text-lg font-bold text-fg">{t(locale, 'mobility.services.title')}</h2>
      <ul class="mt-3 divide-y divide-border border-y border-border">
        {services.map((service) => {
          const image = service.data.images?.[0];
          const title = localize(service.data.title, locale);
          return (
            <li
              id={service.id}
              class="flex min-h-18 scroll-mt-(--size-header) items-center gap-3 py-2.5"
              data-testid="mobility-service"
            >
              {image && (
                <Image
                  src={image.src}
                  alt={localize(image.alt, locale)}
                  width={112}
                  height={112}
                  fit="cover"
                  quality={65}
                  class="h-14 w-14 shrink-0 rounded-sm object-cover"
                />
              )}
              <div class="min-w-0 flex-1">
                <h3 class="text-sm leading-tight font-semibold text-fg">{title}</h3>
                <p class="mt-0.5 text-xs leading-snug text-fg-muted">
                  {localize(service.data.shortDescription, locale)}
                </p>
                <div class="mt-1">
                  <Price price={cardPrice(service.data)} locale={locale} />
                </div>
              </div>
              <div class="flex shrink-0 flex-col items-end">
                <QuickAdd
                  client:visible
                  service={islandOf(service)}
                  locale={locale}
                  title={title}
                />
                <noscript>
                  <a
                    href={requestHref(service)}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex min-h-11 items-center text-sm font-semibold text-brand underline"
                  >
                    {t(locale, 'mobility.request')}
                  </a>
                </noscript>
              </div>
            </li>
          );
        })}
      </ul>
    </section>

    <section class="mt-8 rounded-card bg-footer-bg p-6 text-brand-contrast" data-section="custom">
      <h2 class="font-display text-xl font-extrabold">{t(locale, 'mobility.custom.title')}</h2>
      <p class="mt-2 max-w-xl">{t(locale, 'mobility.custom.text')}</p>
      <a
        href={customHref}
        target="_blank"
        rel="noopener noreferrer"
        class="mt-5 inline-flex min-h-12 items-center gap-2 rounded-md bg-whatsapp px-5 font-semibold text-whatsapp-ink"
      >
        <WhatsAppIcon size={22} />
        {t(locale, 'mobility.custom.cta')}
      </a>
    </section>
  </div>
</BaseLayout>
