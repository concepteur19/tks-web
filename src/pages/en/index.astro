---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { t } from '../../i18n/t.ts';

const locale = 'en' as const;
---

<BaseLayout locale={locale} title={t(locale, 'home.title')}>
  <section class="mx-auto max-w-5xl px-4 py-16">
    <p class="font-script text-2xl text-accent">{t(locale, 'site.tagline')}</p>
    <h1 class="mt-2 font-display text-4xl font-bold text-fg sm:text-5xl">
      {t(locale, 'home.title')}
    </h1>
    <p class="mt-4 text-lg text-fg-muted">{t(locale, 'home.subtitle')}</p>
    <p class="mt-8 max-w-prose text-base text-fg">{t(locale, 'home.intro')}</p>
  </section>
</BaseLayout>
