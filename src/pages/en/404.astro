---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getRoutePath } from '../../i18n/routes.ts';
import { t } from '../../i18n/t.ts';

const locale = 'en' as const;
---

<BaseLayout locale={locale} title={t(locale, 'notFound.title')} noindex={true}>
  <section class="mx-auto max-w-5xl px-4 py-16">
    <h1 class="font-display text-3xl font-bold text-fg">{t(locale, 'notFound.title')}</h1>
    <p class="mt-4 text-fg-muted">{t(locale, 'notFound.text')}</p>
    <a
      href={getRoutePath('home', locale)}
      class="mt-8 inline-flex min-h-11 items-center rounded-md bg-brand px-4 text-brand-contrast"
    >
      {t(locale, 'notFound.back')}
    </a>
  </section>
</BaseLayout>
