---
/**
 * Fiches et pages d'univers partagent l'adresse /experiences/<segment> (008, contracts/routes.md) :
 * le contrôle du contenu garantit qu'aucun identifiant de prestation n'est l'adresse d'un univers.
 */
import ExperienceDetail from '../../../components/experiences/ExperienceDetail.astro';
import UniversePage from '../../../components/experiences/UniversePage.astro';
import { categoriesWithExperiences, getExperiences } from '../../../lib/catalog.ts';

export async function getStaticPaths() {
  const [experiences, universes] = await Promise.all([
    getExperiences(),
    categoriesWithExperiences(),
  ]);
  return [
    ...experiences.map((service) => ({
      params: { slug: service.id },
      props: { kind: 'experience' as const, service },
    })),
    ...universes.map((universe) => ({
      params: { slug: universe.data.urlSlug.en },
      props: { kind: 'universe' as const, universe },
    })),
  ];
}

const props = Astro.props;
---

{props.kind === 'experience' ? (
  <ExperienceDetail service={props.service} locale="en" />
) : (
  <UniversePage universe={props.universe} locale="en" />
)}
