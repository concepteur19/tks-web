---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import type { RouteKey } from '../i18n/routes.ts';
import { t } from '../i18n/t.ts';
import type { Locale } from '../i18n/types.ts';
import { env } from '../lib/env.ts';
import { buildSeo } from '../lib/seo.ts';

/** Contrat : specs/002-kibreeze-core/contracts/shell.md */
interface Props {
  locale: Locale;
  routeKey: RouteKey;
  title: string;
  description?: string;
  noindex?: boolean;
  /** Faux sur les pages qui portent une barre d'action fixe (fiches, Mon séjour). */
  floatingWhatsApp?: boolean;
  jsonLd?: Record<string, unknown>[];
}

const {
  locale,
  title,
  description,
  noindex = false,
  floatingWhatsApp = true,
  jsonLd = [],
} = Astro.props;
const seo = buildSeo({
  path: Astro.url.pathname,
  locale,
  title,
  description: description ?? t(locale, 'site.description'),
  siteUrl: env.siteUrl,
  noindex,
});
const pageTitle = `${title} · ${t(locale, 'site.name')}`;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link
      rel="preload"
      href="/fonts/plus-jakarta-sans-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/caveat-tagline.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <title>{pageTitle}</title>
    <meta name="description" content={seo.description} />
    <link rel="canonical" href={seo.canonical} />
    {seo.alternates.map((alternate) => (
      <link rel="alternate" hreflang={alternate.hreflang} href={alternate.href} />
    ))}
    {seo.noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={seo.description} />
    <meta property="og:url" content={seo.canonical} />
    <meta property="og:locale" content={seo.ogLocale} />
    {seo.ogLocaleAlternate.map((value) => (
      <meta property="og:locale:alternate" content={value} />
    ))}
    <meta name="twitter:card" content="summary_large_image" />
    {jsonLd.map((data) => (
      <script type="application/ld+json" set:html={JSON.stringify(data)}></script>
    ))}
  </head>
  <body class="min-h-screen flex flex-col">
    <a class="skip-link" href="#main">
      {t(locale, 'nav.skipToContent')}
    </a>
    <Nav locale={locale} />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer locale={locale} />
    {floatingWhatsApp && <WhatsAppButton locale={locale} />}
  </body>
</html>
