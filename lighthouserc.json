{
  "ci": {
    "collect": {
      "staticDistDir": "./dist",
      "url": [
        "http://localhost/index.html",
        "http://localhost/en/index.html",
        "http://localhost/contact.html",
        "http://localhost/en/contact.html",
        "http://localhost/404.html",
        "http://localhost/en/404.html",
        "http://localhost/experiences.html",
        "http://localhost/experiences/excursion-en-pirogue.html",
        "http://localhost/sejour.html",
        "http://localhost/experiences/visites.html",
        "http://localhost/experiences/village-mayi.html",
        "http://localhost/hebergements.html",
        "http://localhost/formules.html",
        "http://localhost/mobilite.html",
        "http://localhost/formules/essentiel-de-kribi.html"
      ],
      "numberOfRuns": 3
    },
    "assert": {
      "assertMatrix": [
        {
          "matchingUrlPattern": "^(?!.*404).*$",
          "assertions": {
            "categories:performance": [
              "error",
              {
                "minScore": 0.9
              }
            ],
            "categories:accessibility": [
              "error",
              {
                "minScore": 0.9
              }
            ],
            "categories:best-practices": [
              "error",
              {
                "minScore": 0.9
              }
            ],
            "categories:seo": [
              "error",
              {
                "minScore": 0.9
              }
            ],
            "cumulative-layout-shift": [
              "error",
              {
                "maxNumericValue": 0.1
              }
            ]
          }
        },
        {
          "matchingUrlPattern": ".*404.*",
          "assertions": {
            "categories:performance": [
              "error",
              {
                "minScore": 0.9
              }
            ],
            "categories:accessibility": [
              "error",
              {
                "minScore": 0.9
              }
            ],
            "categories:best-practices": [
              "error",
              {
                "minScore": 0.9
              }
            ],
            "categories:seo": "off",
            "is-crawlable": "off",
            "cumulative-layout-shift": [
              "error",
              {
                "maxNumericValue": 0.1
              }
            ]
          }
        }
      ]
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  }
}
